---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';

const products = (await getCollection('products')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const pageTitle = `Sản phẩm - ${SITE_TITLE}`;
const pageDescription = 'Toàn bộ dàn giáo, cây chống và phụ kiện xây dựng đang cung cấp tại Dàn Giáo Hà Nội.';
---

<!doctype html>
<html lang="vi">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>
	<body class="bg-background text-on-background font-body-md font-sans">
		<Header />
		<main class="w-[90%] max-w-container-max mx-auto py-xl">
			<div class="text-center mb-xl">
				<h1 class="font-headline-lg text-headline-lg text-primary uppercase">Sản Phẩm &amp; Thiết Bị Cung Cấp</h1>
				<p class="font-body-md text-body-md text-on-surface-variant mt-sm">
					Đa dạng chuẩn loại, đáp ứng mọi yêu cầu kỹ thuật khắt khe nhất.
				</p>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter">
				{products.map((product) => <ProductCard product={product} />)}
			</div>
		</main>
		<Footer />
	</body>
</html>
