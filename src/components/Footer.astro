---
import { NAV_LINKS, SITE_ADDRESS, SITE_PHONE_DISPLAY, SITE_PHONE_TEL, SITE_TITLE, SITE_ZALO_URL } from '../consts';

const today = new Date();
const mapEmbedSrc = `https://www.google.com/maps?q=${encodeURIComponent(SITE_ADDRESS)}&output=embed`;
---

<footer class="bg-primary w-full border-t border-outline-variant font-sans">
	<div class="grid grid-cols-1 md:grid-cols-3 gap-xl w-[90%] max-w-container-max mx-auto py-xl">
		<div>
			<div class="font-headline-md text-headline-md text-on-primary mb-md flex items-center gap-sm">
				<span class="material-symbols-outlined" style="font-size: 1.5rem;">construction</span>
				{SITE_TITLE.toUpperCase()}
			</div>
			<p class="text-on-primary font-body-md text-body-md mb-sm flex items-center gap-sm">
				<span class="material-symbols-outlined text-secondary-fixed-dim" style="font-size: 1.2rem;"
					>location_on</span
				>
				{SITE_ADDRESS}
			</p>
			<p class="text-on-primary font-body-md text-body-md mb-sm flex items-center gap-sm">
				<span class="material-symbols-outlined text-secondary-fixed-dim" style="font-size: 1.2rem;">call</span>
				<a href={`tel:${SITE_PHONE_TEL}`} class="text-on-primary">{SITE_PHONE_DISPLAY}</a>
			</p>
		</div>
		<div>
			<h4
				class="font-label-bold text-label-bold text-on-primary uppercase tracking-wider mb-md border-b border-on-primary-fixed-variant inline-block pb-xs"
			>
				Liên Kết Nhanh
			</h4>
			<ul class="flex flex-col gap-sm">
				{
					NAV_LINKS.map((link) => (
						<li>
							<a
								class="text-on-primary font-label-sm text-label-sm hover:text-secondary-container transition-colors"
								href={link.href}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
		<div>
			<h4
				class="font-label-bold text-label-bold text-on-primary uppercase tracking-wider mb-md border-b border-on-primary-fixed-variant inline-block pb-xs"
			>
				Bản Đồ
			</h4>
			<div class="w-full h-32 bg-surface-container-highest border border-outline-variant overflow-hidden">
				<iframe
					src={mapEmbedSrc}
					class="w-full h-full border-0"
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"
					title={`Bản đồ ${SITE_ADDRESS}`}
				></iframe>
			</div>
		</div>
	</div>
	<div class="border-t border-on-primary-fixed-variant">
		<div class="w-[90%] max-w-container-max mx-auto py-md text-center text-on-primary font-label-sm text-label-sm opacity-70">
			&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved. Địa chỉ: {SITE_ADDRESS}.
		</div>
	</div>
</footer>

<div class="fixed bottom-lg right-lg flex flex-col gap-sm z-50">
	<a
		class="w-12 h-12 rounded-full bg-[#0068ff] text-white flex items-center justify-center shadow-lg hover:scale-110 transition-transform"
		href={SITE_ZALO_URL}
		target="_blank"
		rel="noopener"
		data-track="click_zalo"
		aria-label="Chat Zalo"
	>
		<span class="material-symbols-outlined">chat</span>
	</a>
	<a
		class="w-12 h-12 rounded-full cta-primary flex items-center justify-center shadow-lg hover:scale-110 transition-transform"
		href={`tel:${SITE_PHONE_TEL}`}
		data-track="click_phone"
		aria-label={`Gọi ${SITE_PHONE_DISPLAY}`}
	>
		<span class="material-symbols-outlined text-on-primary">call</span>
	</a>
</div>
